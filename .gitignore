# Virtual environments
.venv/
agentcore_fallback/.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# IDE / Editor
.vscode/
.claude/
*.swp
*.swo

# Node.js
node_modules/

# Large binaries — do not commit
*.zip
*.tar.gz
files/
files.zip
codemagic.yaml

# Runtime logs and test artefacts — generated locally, never commit
bridge.log
bridge_err.log
*.log
test_results.txt
_archive/

# Runtime data — databases and legacy flat files (all replaced by agent.db / analytics.duckdb)
agent.db
analytics.duckdb
trainer.db
few_shot_memory.db
routing_log.jsonl
benchmark_results.json
gesture_calibration.json
hotwords.txt

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Docs — large binaries (keep markdown docs)
docs/*.pdf
docs/*.ipa
docs/*.exe
docs/*.xip

# Signing — NEVER commit these
docs/distribution.key
docs/distribution.pem
docs/distribution.p12
docs/distribution.cer
docs/ios_development.cer
docs/CertificateSigningRequest.certSigningRequest
docs/cert_base64.txt
docs/profile_base64.txt
docs/*.mobileprovision
docs/*.p8

# Sensitive account files — NEVER commit these
docs/Apple Account Recovery_Key.txt

# Photos / screenshots — binary blobs, not useful in git history
docs/*.jpeg
docs/*.jpg
docs/*.png
