# Self-skilling (rung 2 / macros) eval suite — model-free, deterministic.
# Each case scripts synthetic successful runs and asserts MacroDetector staging
# (and optionally MacroStore replay). Baseline: exact_acc=1.0. See spec §5.
{"id": "detect_three_step", "runs": [{"goal": "start a note", "steps": [["OPEN", "notepad"], ["CLICK", "body"], ["TYPE", "hi"]]}, {"goal": "start a note", "steps": [["OPEN", "notepad"], ["CLICK", "body"], ["TYPE", "hi"]]}, {"goal": "start a note", "steps": [["OPEN", "notepad"], ["CLICK", "body"], ["TYPE", "hi"]]}], "expect_staged": 1, "expect_signature": "OPEN(STR) → CLICK(STR) → TYPE(STR)", "replay": {"expect_status": "ok", "expect_steps_run": 3}, "tags": ["detect", "replay"]}
{"id": "below_threshold", "runs": [{"goal": "rare", "steps": [["OPEN", "a"], ["CLICK", "b"]]}, {"goal": "rare", "steps": [["OPEN", "a"], ["CLICK", "b"]]}], "min_occurrences": 3, "expect_staged": 0, "tags": ["threshold"]}
{"id": "missing_tool_not_staged", "runs": [{"goal": "bad verb", "steps": [["OPEN", "a"], ["FROBNICATE", "b"]]}, {"goal": "bad verb", "steps": [["OPEN", "a"], ["FROBNICATE", "b"]]}, {"goal": "bad verb", "steps": [["OPEN", "a"], ["FROBNICATE", "b"]]}], "expect_staged": 0, "tags": ["tool-exist", "R1.3"]}
{"id": "replay_missing_tool_clarifies", "runs": [{"goal": "two verbs", "steps": [["OPEN", "a"], ["CLICK", "b"]]}, {"goal": "two verbs", "steps": [["OPEN", "a"], ["CLICK", "b"]]}, {"goal": "two verbs", "steps": [["OPEN", "a"], ["CLICK", "b"]]}], "expect_staged": 1, "replay": {"known_verbs": ["CLICK"], "expect_status": "clarify"}, "tags": ["replay", "R5.3"]}
{"id": "param_required_clarifies", "runs": [{"goal": "typed thing", "steps": [["OPEN", "notepad"], ["TYPE", "alpha"]]}, {"goal": "typed thing", "steps": [["OPEN", "notepad"], ["TYPE", "beta"]]}, {"goal": "typed thing", "steps": [["OPEN", "notepad"], ["TYPE", "gamma"]]}], "expect_staged": 1, "replay": {"expect_status": "clarify"}, "tags": ["replay", "param"]}
{"id": "param_supplied_runs", "runs": [{"goal": "typed thing", "steps": [["OPEN", "notepad"], ["TYPE", "alpha"]]}, {"goal": "typed thing", "steps": [["OPEN", "notepad"], ["TYPE", "beta"]]}, {"goal": "typed thing", "steps": [["OPEN", "notepad"], ["TYPE", "gamma"]]}], "expect_staged": 1, "replay": {"expect_status": "ok", "expect_steps_run": 2, "params": {"1": "the text"}}, "tags": ["replay", "param"]}
{"id": "fuzzy_merge_single_slot", "runs": [{"goal": "merge", "steps": [["OPEN", "notepad"], ["CLICK", "body"]]}, {"goal": "merge", "steps": [["OPEN", "notepad"], ["CLICK", "body"]]}, {"goal": "merge", "steps": [["OPEN", "src/x.py"], ["CLICK", "body"]]}, {"goal": "merge", "steps": [["OPEN", "src/x.py"], ["CLICK", "body"]]}], "min_occurrences": 3, "similarity": 0.5, "expect_staged": 1, "tags": ["fuzzy"]}
{"id": "two_distinct_macros", "runs": [{"goal": "edit", "steps": [["READ_FILE", "a.py"], ["WRITE_FILE", "a.py"]]}, {"goal": "edit", "steps": [["READ_FILE", "b.py"], ["WRITE_FILE", "b.py"]]}, {"goal": "edit", "steps": [["READ_FILE", "c.py"], ["WRITE_FILE", "c.py"]]}, {"goal": "ui flow", "steps": [["OPEN", "app"], ["CLICK", "x"], ["HOTKEY", "ctrl+s"]]}, {"goal": "ui flow", "steps": [["OPEN", "app"], ["CLICK", "y"], ["HOTKEY", "ctrl+s"]]}, {"goal": "ui flow", "steps": [["OPEN", "app"], ["CLICK", "z"], ["HOTKEY", "ctrl+s"]]}], "expect_staged": 2, "tags": ["multi"]}
