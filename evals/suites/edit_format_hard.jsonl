# edit_format_hard — the elision-stress subset for the edit-format A/B (task 6).
#
# Same harness/scoring as edit_format.jsonl (--mode edit_ab), but over LONG
# fixtures (~120-180 lines, many methods) with a SMALL targeted edit. The point
# is to stress the whole_file arm's silent-elision failure mode: re-typing the
# whole long file to make a one-line change risks dropping a method. The `preserve`
# list names (nearly) every existing def, so any drop fails the case — that is the
# direct measurement of whether hashline's targeted ops beat whole-file overwrite
# on CORRECTNESS (not just output size) once files get big.
{"id": "efh-eventbus-subcount", "suite": "edit_format_hard", "fixture": "event_bus.py", "instruction": "Add a `subscriber_count(self, topic)` method to EventBus that returns the number of subscriptions registered for that topic (len of self._subs.get(topic, [])).", "expect_contains": ["def subscriber_count"], "expect_absent": [], "preserve": ["def subscribe", "def subscribe_once", "def unsubscribe", "def unsubscribe_all", "def publish", "def _record", "def pause", "def resume", "def topics", "def history", "def clear_history", "def has_subscribers", "def reset"], "tags": ["edit_format", "hard", "add_method", "long_file"]}
{"id": "efh-vector3-cross", "suite": "edit_format_hard", "fixture": "vector3.py", "instruction": "There is a sign bug in the cross product: the y-component cy is computed as `self.z * other.x + self.x * other.z` but a cross product's y-component is a subtraction. Fix only that line to `self.z * other.x - self.x * other.z`.", "expect_contains": ["self.z * other.x - self.x * other.z"], "expect_absent": ["self.z * other.x + self.x * other.z"], "preserve": ["def __add__", "def __sub__", "def __neg__", "def scale", "def dot", "def cross", "def length_squared", "def length", "def normalized", "def distance_to", "def lerp", "def is_zero", "def manhattan", "def max_component", "def min_component", "def as_tuple", "def from_tuple"], "tags": ["edit_format", "hard", "bugfix", "long_file"]}
{"id": "efh-csvtable-colsum", "suite": "edit_format_hard", "fixture": "csv_table.py", "instruction": "Add a `column_sum(self, name)` method to Table that returns the sum of the values in the named column (reuse self.column(name)).", "expect_contains": ["def column_sum"], "expect_absent": [], "preserve": ["def add_row", "def add_rows", "def row_count", "def column", "def _check_column", "def select", "def filter", "def sort_by", "def map_column", "def distinct", "def aggregate", "def head", "def to_dicts"], "tags": ["edit_format", "hard", "add_method", "long_file"]}
{"id": "efh-bank-interest", "suite": "edit_format_hard", "fixture": "bank_account.py", "instruction": "apply_interest has a bug: it divides annual_rate_pct by 10, but a percentage must be divided by 100. Fix only that line so it computes self.balance * (annual_rate_pct / 100).", "expect_contains": ["(annual_rate_pct / 100)"], "expect_absent": ["(annual_rate_pct / 10)"], "preserve": ["def _post", "def deposit", "def withdraw", "def charge_fee", "def apply_interest", "def _require_active", "def freeze", "def unfreeze", "def transfer_to", "def ledger", "def transaction_count", "def total_deposited", "def total_withdrawn", "def statement"], "tags": ["edit_format", "hard", "bugfix", "long_file"]}
{"id": "efh-lru-peek", "suite": "edit_format_hard", "fixture": "lru_cache.py", "instruction": "Add a `peek(self, key, default=None)` method to LRUCache that returns the value for key WITHOUT moving it to the most-recently-used end and WITHOUT touching hit/miss stats (return default if absent).", "expect_contains": ["def peek"], "expect_absent": [], "preserve": ["def get", "def put", "def contains", "def invalidate", "def clear", "def resize", "def keys", "def values", "def __len__", "def hit_rate", "def reset_stats"], "tags": ["edit_format", "hard", "add_method", "long_file", "tail_edit"]}
