# skill_triggers — utterance -> which SKILL should fire. MODEL-FREE.
# expected_verb holds the expected skill_id (matched via the REAL SkillRegistry.match_intent
# over every shipped manifest), or "none" when NO skill should fire (negative / boundary case).
# The whitepaper's first eval gate: positive AND negative triggers, target >=90% accuracy.
# Every manifest is loaded regardless of `enabled` — we gate the routing LOGIC, not user state.
#
# --- arxiv (positive) ---
{"id": "trg-arxiv-search", "suite": "skill_triggers", "utterance": "find papers about diffusion transformers", "expected_verb": "arxiv", "tags": ["positive"]}
{"id": "trg-arxiv-recent", "suite": "skill_triggers", "utterance": "any recent papers in quant-ph?", "expected_verb": "arxiv", "tags": ["positive"]}
{"id": "trg-arxiv-fetch", "suite": "skill_triggers", "utterance": "download the paper 2406.01234", "expected_verb": "arxiv", "tags": ["positive"]}
