# dev_critic eval suite — plausible-but-wrong edits the lint gate cannot catch.
# Each case: fixture = original file (good), bad_code = the edit the agent produced
# (wrong), goal = what the edit was SUPPOSED to do. Critic should return REVISE/BLOCK.
{"id": "dc-01", "suite": "dev_critic", "fixture": "stack.py", "goal": "Add a pop() method that removes and returns the top element; raise IndexError if the stack is empty", "bad_code": "\"\"\"Stack data structure — fixture for dev_critic eval (dc-01).\"\"\"\n\n\nclass Stack:\n    def __init__(self):\n        self._items = []\n\n    def push(self, item):\n        self._items.append(item)\n\n    def peek(self):\n        if not self._items:\n            raise IndexError(\"peek from empty stack\")\n        return self._items[-1]\n\n    def __len__(self):\n        return len(self._items)\n\n    def is_empty(self):\n        return len(self._items) == 0\n\n    def pop(self):\n        if len(self._items) < 0:  # BUG: < 0 is never True; should be == 0\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n", "bug_type": "correctness", "bug_description": "Guard condition `len < 0` is always False — IndexError is never raised on an empty stack; pop() returns None instead", "tags": ["correctness", "dead-branch"]}
{"id": "dc-02", "suite": "dev_critic", "fixture": "bank_account.py", "goal": "Add a withdraw(amount) method: deduct amount from balance; raise ValueError if insufficient funds or amount <= 0", "bad_code": "\"\"\"Simple bank account — fixture for dev_critic eval (dc-02).\"\"\"\n\n\nclass BankAccount:\n    def __init__(self, balance=0.0):\n        self.balance = float(balance)\n\n    def deposit(self, amount):\n        if amount <= 0:\n            raise ValueError(\"deposit amount must be positive\")\n        self.balance += amount\n        return self.balance\n\n    def get_balance(self):\n        return self.balance\n\n    def withdraw(self, amount):\n        if amount <= 0:\n            raise ValueError(\"amount must be positive\")\n        if self.balance < amount:\n            raise ValueError(\"insufficient funds\")\n        self.balance = amount  # BUG: assignment instead of subtraction\n        return self.balance\n", "bug_type": "correctness", "bug_description": "`self.balance = amount` sets balance TO the withdrawal amount instead of subtracting it; balance becomes the amount withdrawn rather than what remains", "tags": ["correctness", "wrong-operator"]}
{"id": "dc-03", "suite": "dev_critic", "fixture": "token_bucket.py", "goal": "Add a consume(tokens=1) method: return True and deduct tokens if available, False if the bucket does not have enough", "bad_code": "\"\"\"Token-bucket rate limiter — fixture for dev_critic eval (dc-03).\"\"\"\n\nimport time\n\n\nclass TokenBucket:\n    def __init__(self, rate, capacity):\n        self.rate = rate\n        self.capacity = capacity\n        self._tokens = float(capacity)\n        self._last_refill = time.monotonic()\n\n    def _refill(self):\n        now = time.monotonic()\n        elapsed = now - self._last_refill\n        self._tokens = min(self.capacity, self._tokens + elapsed * self.rate)\n        self._last_refill = now\n\n    def consume(self, tokens=1):\n        self._refill()\n        if self._tokens >= tokens:  # BUG: inverted; should be < (blocks when we have enough, allows when we don't)\n            return False\n        self._tokens -= tokens\n        return True\n", "bug_type": "correctness", "bug_description": "Guard is inverted: `>= tokens` returns False (deny) when the bucket IS full enough; the method allows requests only when the bucket is depleted", "tags": ["correctness", "inverted-logic"]}
{"id": "dc-04", "suite": "dev_critic", "fixture": "event_aggregator.py", "goal": "Add a flush() method that returns all accumulated events as a list and clears the internal buffer", "bad_code": "\"\"\"Event accumulator — fixture for dev_critic eval (dc-04).\"\"\"\n\n\nclass EventAggregator:\n    def __init__(self):\n        self._events = []\n\n    def record(self, event):\n        self._events.append(event)\n\n    def count(self):\n        return len(self._events)\n\n    def peek_all(self):\n        \"\"\"Return events without clearing.\"\"\"\n        return list(self._events)\n\n    def flush(self):\n        saved = list(self._events)\n        self._events.clear()\n        return self._events  # BUG: returns the now-empty list, not `saved`\n", "bug_type": "correctness", "bug_description": "`return self._events` returns the cleared (empty) list; the caller always gets [] even though events were recorded. Should return `saved`", "tags": ["correctness", "wrong-variable"]}
{"id": "dc-05", "suite": "dev_critic", "fixture": "path_utils.py", "goal": "Add a safe_join(base, *parts) function: join path components but raise ValueError if any part is absolute or contains '..' (path traversal prevention)", "bad_code": "\"\"\"Path utilities — fixture for dev_critic eval (dc-05).\"\"\"\n\nimport os\n\n\ndef normalize_path(path):\n    return os.path.normpath(path)\n\n\ndef ensure_dir(path):\n    os.makedirs(path, exist_ok=True)\n    return path\n\n\ndef safe_join(base, *parts):\n    for part in parts:\n        if os.path.isabs(part):\n            raise ValueError(f\"absolute path not allowed: {part}\")\n        # BUG: missing '..' check — path traversal via '../../../etc/passwd' is not blocked\n    return os.path.join(base, *parts)\n", "bug_type": "security", "bug_description": "The '..' traversal check is absent: `safe_join('/data', '../../etc/passwd')` silently succeeds, allowing path traversal outside the intended base", "tags": ["security", "missing-check"]}
{"id": "dc-06", "suite": "dev_critic", "fixture": "retry.py", "goal": "Add a retry(fn, max_attempts=3, delay=1.0) function: call fn(), retry on any exception up to max_attempts times with delay seconds between attempts, re-raise the last exception if all attempts fail", "bad_code": "\"\"\"Retry utility — fixture for dev_critic eval (dc-06).\"\"\"\n\nimport time\nimport threading\n\n\ndef with_timeout(fn, timeout):\n    \"\"\"Call fn(); raise TimeoutError if it takes longer than timeout seconds.\"\"\"\n    result = [None]\n    exc = [None]\n\n    def target():\n        try:\n            result[0] = fn()\n        except Exception as e:\n            exc[0] = e\n\n    t = threading.Thread(target=target, daemon=True)\n    t.start()\n    t.join(timeout)\n    if t.is_alive():\n        raise TimeoutError(f\"fn() did not complete in {timeout}s\")\n    if exc[0] is not None:\n        raise exc[0]\n    return result[0]\n\n\ndef retry(fn, max_attempts=3, delay=1.0):\n    last_exc = None\n    for attempt in range(max_attempts):\n        try:\n            return fn()\n        except Exception as e:\n            last_exc = e\n            if attempt < max_attempts:  # BUG: should be max_attempts - 1; always sleeps even after final failure\n                time.sleep(delay)\n    raise last_exc\n", "bug_type": "correctness", "bug_description": "`attempt < max_attempts` is always True inside the loop (attempt is 0..max_attempts-1), so delay is always applied including after the last failed attempt; should be `attempt < max_attempts - 1`", "tags": ["correctness", "off-by-one"]}
{"id": "dc-07", "suite": "dev_critic", "fixture": "shell_runner.py", "goal": "Add a run_cmd(cmd) function that accepts a command string, runs it in a shell, and returns the stdout output as a string", "bad_code": "\"\"\"Shell execution helpers — fixture for dev_critic eval (dc-07).\"\"\"\n\nimport subprocess\n\n\ndef safe_run(args, *, timeout=30):\n    \"\"\"Run a command with an explicit arg list (no shell=True, no injection risk).\"\"\"\n    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)\n    result.check_returncode()\n    return result.stdout\n\n\ndef run_cmd(cmd):\n    \"\"\"Run a shell command string and return stdout.\"\"\"\n    result = subprocess.run(\n        f\"bash -c '{cmd}'\",  # BUG: shell injection — single quotes in cmd break out of the quoting\n        shell=True, capture_output=True, text=True, timeout=30,\n    )\n    return result.stdout\n", "bug_type": "security", "bug_description": "Command assembled with an f-string inside single quotes: if `cmd` contains a single quote the quoting breaks, allowing arbitrary shell injection. Should use `['bash', '-c', cmd]` with `shell=False`", "tags": ["security", "shell-injection"]}
{"id": "dc-08", "suite": "dev_critic", "fixture": "config_loader.py", "goal": "Add a load_config(path, defaults=None) function: read and return the JSON file at path merged over defaults; if the file is missing return defaults (or {} if defaults is None)", "bad_code": "\"\"\"Config file loader — fixture for dev_critic eval (dc-08).\"\"\"\n\nimport json\nimport os\n\n\ndef write_config(path, data):\n    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(data, f, indent=2)\n\n\ndef load_config(path, defaults=None):\n    base = defaults or {}\n    try:\n        with open(path, encoding=\"utf-8\") as f:\n            data = json.load(f)\n        base.update(data)  # BUG: mutates the caller's dict in-place; should create a new dict\n        return base\n    except FileNotFoundError:\n        return base\n", "bug_type": "correctness", "bug_description": "`base.update(data)` mutates the dict the caller passed as `defaults`; side-effects leak across calls. Should be `return {**base, **data}` to return a new merged dict", "tags": ["correctness", "mutation-bug"]}
